{
  "name": "tryon-app",
  "private": true,
  "version": "2.0.0",
  "description": "試穿吧 TryOn iOS / Android App（Capacitor，打包網站）",
  "scripts": {
    "web": "bash prepare-web.sh",
    "sync:android": "bash prepare-web.sh && npx cap sync android && node patch-native.js",
    "sync:ios": "bash prepare-web.sh && npx cap sync ios && node patch-native.js",
    "sync": "bash prepare-web.sh && npx cap sync && node patch-native.js",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#e8657a' --iconBackgroundColorDark '#e8657a' --splashBackgroundColor '#fff8f5' --splashBackgroundColorDark '#241b1e'"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/capacitor-social-login": "^8.7.5"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  }
}
